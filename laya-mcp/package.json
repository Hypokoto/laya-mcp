{
  "name": "laya-mcp",
  "version": "1.0.0",
  "description": "Universal Laya ONNX MCP server for agent decision making, security policy enforcement, and code analysis",
  "type": "module",
  "bin": {
    "laya-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "start:http": "node dist/index.js --http 3000",
    "setup": "node dist/index.js setup",
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "hook:install": "node dist/index.js hook:install",
    "hook:uninstall": "node dist/index.js hook:uninstall",
    "test": "tsx tests/handshake_test.ts && tsx tests/evaluation_test.ts && tsx tests/hook_test.ts",
    "test:handshake": "tsx tests/handshake_test.ts",
    "test:eval": "tsx tests/evaluation_test.ts",
    "test:hook": "tsx tests/hook_test.ts"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@huggingface/tokenizers": "^0.2.0",
    "@modelcontextprotocol/sdk": "^1.6.1",
    "@types/express": "^5.0.6",
    "express": "^5.2.1",
    "onnxruntime-web": "^1.30.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
